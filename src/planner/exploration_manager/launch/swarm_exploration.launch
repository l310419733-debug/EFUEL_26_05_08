<launch>
  <!-- size of map, change the size in x, y, z according to your application -->
  <arg name="map_size_x" value="16.0"/>
  <arg name="map_size_y" value="30.0"/>
  <arg name="map_size_z" value=" 3.5"/>

  <!-- boundary for exploration, change the size in x, y, z according to your application -->
  <arg name="bound_min_x" value="-8.0"/>
  <arg name="bound_min_y" value="-15.0"/>
  <arg name="bound_min_z" value="-0.1"/> 
  <arg name="bound_max_x" value="8.0"/>
  <arg name="bound_max_y" value="15.0"/>
  <arg name="bound_max_z" value="2.0"/>   

  <!-- Global odom prefix -->
  <arg name="odom_prefix" value="/state_ukf/odom" />
  <arg name="drone_num" value="2" />
  <arg name="config_file" default="$(find multi_target_kf)/config/kf_params.yaml"/>
  <arg name="detections_topic" default="drone_detections"/>
  <arg name="respawn" default="false"/>"

    <!-- Map generation -->
  <!-- <node pkg ="map_generator" name ="map_pub" type ="map_pub" output = "screen" args="$(find map_generator)/resource/office.pcd">    
  </node> -->
  <node pkg ="map_generator" name ="map_pub" type ="map_pub" output = "screen" args="$(find map_generator)/resource/office.pcd">    
  </node>

    <!-- Multi-target KF tracker-->
  <node pkg="multi_target_kf" name="kf_tracker_node" type="kf_tracker_node" output="screen" clear_params="true" required="$(eval not respawn)" respawn="$(arg respawn)">
      <remap from="exploration_node_2/measurement/pose_array" to="$(arg detections_topic)"/>
      <rosparam command="load" file="$(arg config_file)"/>
  </node>
    
 
 <include file="$(find exploration_manager)/launch/single_drone_exploration.xml">
    <arg name="drone_id" value="1"/>
    <arg name="init_x"   value="0"/>
    <arg name="init_y"   value="0"/>
    <arg name="init_z"   value="1"/> 
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="odom_prefix" value="$(arg odom_prefix)"/>
    <arg name="drone_num" value="$(arg drone_num)"/>
    <arg name="simulation" default="true"/>
    
    <arg name="bound_min_x" value="$(arg bound_min_x)"/>
    <arg name="bound_min_y" value="$(arg bound_min_y)"/>
    <arg name="bound_min_z" value="$(arg bound_min_z)"/> 
    <arg name="bound_max_x" value="$(arg bound_max_x)"/>
    <arg name="bound_max_y" value="$(arg bound_max_y)"/>
    <arg name="bound_max_z" value="$(arg bound_max_z)"/> 
  </include>

